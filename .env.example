# Supabase Configuration
# Used in: LearnerDataPage, ReadingPage, ListeningPage, SpeakingPage, OpinionPage, WritingPage, ReportPage
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI API
# Used in: WelcomePage, SpeakingPage, OpinionPage
OPENAI_API_KEY=your_openai_api_key

# SpeechAce API
# Used in: OpinionPage
SPEECHACE_API_KEY=your_speechace_api_key

# Google Cloud (for speech-to-text)
# Used in: WelcomePage, SpeakingPage, OpinionPage
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key
GOOGLE_APPLICATION_CREDENTIALS=your_google_credentials_path
